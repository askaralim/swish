# Copy to .env (see .gitignore). Values are baked in at build time where noted.

# Public API (also set in eas.json for preview/production)
EXPO_PUBLIC_API_URL=https://nba-stats-api-production.up.railway.app

# Sentry — must be EXPO_PUBLIC_* so Metro inlines it into the JS bundle
EXPO_PUBLIC_SENTRY_DSN=
# Optional: send Sentry from __DEV__ builds (dev client)
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=
# Optional: verbose Sentry SDK logs in dev
EXPO_PUBLIC_SENTRY_DEBUG=

# PostHog — read by app.config.js into expo.extra (not EXPO_PUBLIC_*)
POSTHOG_PROJECT_TOKEN=
# e.g. https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
POSTHOG_HOST=
